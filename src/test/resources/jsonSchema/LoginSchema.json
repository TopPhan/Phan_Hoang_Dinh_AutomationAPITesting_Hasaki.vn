              "type": "number"
            },
            "hash_key": {
              "type": "string"
            },
            "access_token": {},
            "chat_token": {
              "type": "string"
            },
            "email": {
              "type": "string"
            },
            "first_name": {
              "type": "string"
            },
            "last_name": {},
            "full_name": {
              "type": "string"
            },
            "avatar_url": {
              "type": "string"
            },
            "phone": {},
            "gender": {
              "type": "number"
            },
            "dob": {
              "type": "number"
            },
            "user_type": {
              "type": "string"
            },
            "is_subscribed": {
              "type": "boolean"
