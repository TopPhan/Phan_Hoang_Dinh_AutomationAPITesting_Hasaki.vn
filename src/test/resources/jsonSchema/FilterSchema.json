{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hasaki Filter API Response Schema",
  "type": "object",
  "required": ["status", "data"],
  "properties": {
    "status": {
      "type": "object",
      "required": ["error_code", "error_message"],
      "properties": {
        "error_code":    { "type": "number" },
        "error_message": { "type": "string" },
        "alert_message": { "type": "string" }
      }
    },
    "data": {
      "type": "object",
      "required": ["filter"],
      "properties": {
        "filter": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "name", "type", "values"],
            "properties": {
              "key":         { "type": "string" },
              "name":        { "type": "string" },
              "type":        { "type": "string" },
              "limitselect": { "type": "number" },
              "sort_order":  { "type": "number" },
              "values": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["key", "label", "value"],
                  "properties": {
                    "key":   { "type": "string" },
                    "label": { "type": "string" },
                    "value": { "type": "number" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
