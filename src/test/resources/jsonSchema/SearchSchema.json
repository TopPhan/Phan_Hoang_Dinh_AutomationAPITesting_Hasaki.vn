{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hasaki Search API Response Schema",
  "description": "Schema đúng với response thực tế của GET /mobile/v1/main/search",
  "type": "object",
  "required": ["status", "data"],
  "properties": {
    "status": {
      "type": "object",
      "required": ["error_code", "error_message", "alert_message"],
      "properties": {
        "error_code":    { "type": "integer" },
        "error_message": { "type": "string" },
        "alert_message": { "type": "string" }
      }
    },
    "data": {
      "type": "object",
      "required": ["meta_data", "is_redirect", "products"],
      "properties": {
        "meta_data": {
          "type": "object",
          "required": ["products_total", "sort_params"],
          "properties": {
            "products_total": { "type": "integer", "minimum": 0 },
            "current_cate":   { "type": "array" },
            "is_spa":         { "type": "boolean" },
            "log": {
              "type": "object",
              "properties": {
                "usrId":  { "type": "string" },
                "total":  { "type": "integer" },
                "limit":  { "type": "integer" },
                "srt":    { "type": "integer" },
                "lstId":  { "type": "string" }
              }
            },
            "sort_params": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["label", "value", "selected"],
                "properties": {
                  "label":    { "type": "string" },
                  "value":    { "type": "string" },
                  "selected": { "type": "boolean" }
                }
              }
            }
          }
        },
        "is_redirect":  { "type": "boolean" },
        "url_redirect": { "type": "string" },
        "products": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "sku", "name", "price", "image"],
            "properties": {
              "id":               { "type": "integer", "minimum": 1 },
              "sku":              { "type": "string" },
              "name":             { "type": "string" },
              "product_url":      { "type": "string" },
              "english_name":     { "type": ["string", "null"] },
              "category_name":    { "type": "string" },
              "brand": {
                "type": "object",
                "required": ["id", "name"],
                "properties": {
                  "id":   { "type": "integer" },
                  "name": { "type": "string" }
                }
              },
              "image":            { "type": "string" },
              "market_price":     { "type": "integer", "minimum": 0 },
              "price":            { "type": "integer", "minimum": 0 },
              "discount_percent": { "type": "integer", "minimum": 0 },
              "quantity":         { "type": "integer", "minimum": 0 },
              "bought_count":     { "type": "integer", "minimum": 0 },
              "is_spa":           { "type": "boolean" },
              "category_id":      { "type": "integer" },
              "rating": {
                "type": ["object", "null"],
                "properties": {
                  "avgPercent": { "type": "number" },
                  "avg_rate":   { "type": "number" },
                  "total_rate": { "type": "integer" }
                }
              }
            }
          }
        }
      }
    }
  }
}
